generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  MARKETING
  FINANCE
  SUPPORT
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum PlanType {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum AgentRunStatus {
  PENDING
  RUNNING
  APPROVAL_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  DECISION
  EVENT
  LEARNING
  POLICY
  CONSTRAINT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalType {
  CAMPAIGN
  DISCOUNT
  EXPENSE
  PRODUCT
  PRICE_CHANGE
  ORDER_REFUND
  INTEGRATION
  AUTOMATION
  CONTENT_PUBLISH
  AD_SPEND
  COMMUNICATION
  OTHER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowStepType {
  TRIGGER
  CONDITION
  DELAY
  BRANCH
  AI_DECISION
  ACTION
  RETRY
  TIMEOUT
  END
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  ADS
  SOCIAL
  SEO
  CONTENT
  INFLUENCER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WebhookStatus {
  ACTIVE
  DISABLED
  FAILING
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationChannel {
  WHATSAPP
  EMAIL
  SMS
  CHAT
  INSTAGRAM
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  ARCHIVED
}

enum ExperimentType {
  A_B
  PRICING
  LANDING_PAGE
  CREATIVE
  OFFER
  EMAIL
  BUNDLE
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
  DISCONNECTED
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

enum PageType {
  HOMEPAGE
  PRODUCT
  COLLECTION
  CART
  CHECKOUT
  ABOUT
  FAQ
  CONTACT
  POLICIES
  CUSTOM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ClickStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  domain                String?                @unique
  customDomain          String?                @unique
  status                TenantStatus           @default(TRIAL)
  plan                  PlanType               @default(STARTER)
  settings              Json?
  metadata              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  storefronts           Storefront[]
  orders                Order[]
  agents                Agent[]
  businesses            Business[]
  goals                 BusinessGoal[]
  policies              BusinessPolicy[]
  memories              BusinessMemory[]
  decisions             BusinessDecision[]
  events                BusinessEvent[]
  pages                 Page[]
  collections           Collection[]
  inventoryMovements    InventoryMovement[]
  leads                 Lead[]
  companies             Company[]
  segments              Segment[]
  conversations         Conversation[]
  messages              Message[]
  payments              Payment[]
  refunds               Refund[]
  shipments             Shipment[]
  campaigns             Campaign[]
  audiences             Audience[]
  creatives             Creative[]
  ads                   Ad[]
  emailCampaigns        EmailCampaign[]
  emailMessages         EmailMessage[]
  smsCampaigns          SMSCampaign[]
  smsMessages           SMSMessage[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  workflows             Workflow[]
  workflowRuns          WorkflowRun[]
  templates             Template[]
  automationRules       AutomationRule[]
  agentTasks            AgentTask[]
  agentDecisions        AgentDecision[]
  tools                 Tool[]
  toolExecutions        ToolExecution[]
  approvals             Approval[]
  revenues              Revenue[]
  expenses              Expense[]
  invoices              Invoice[]
  experiments           Experiment[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  integrations          Integration[]
  oauthConnections      OAuthConnection[]
  webhooks              Webhook[]
  subscriptions         Subscription[]
  entitlements          Entitlement[]
  usageRecords          UsageRecord[]
  billingEvents         BillingEvent[]
  domains               Domain[]
  storeDomains          StoreDomain[]
  notifications         Notification[]
  emailConfig           TenantEmailConfig?
  carts                 Cart[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  lowStockAlerts        LowStockAlert[]
  stores                Store[]
  themes                Theme[]
}

model User {
  id                 String              @id @default(cuid())
  tenantId           String?
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String              @unique
  password           String
  firstName          String?
  lastName           String?
  avatar             String?
  role               Role                @default(EMPLOYEE)
  isActive           Boolean             @default(true)
  emailVerified      Boolean             @default(false)
  provider           String              @default("email")
  lastLoginAt        DateTime?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  headCommissions    Commission[]        @relation("HeadCommissions")
  partnerCommissions Commission[]        @relation("PartnerCommissions")
  partnerAssignments PartnerAssignment[] @relation("HeadRelation")
  partnerAssignedTo  PartnerAssignment[] @relation("PartnerRelation")
  headAssignments    HeadAssignment[]
  auditLogs          AuditLog[]
  sessions           Session[]
  leads              Lead[]
  approvals          Approval[]          @relation("ApprovalRequester")
  approvedApprovals  Approval[]          @relation("ApprovalDecider")
  agentTasks         AgentTask[]
  experiments        Experiment[]
  notifications      Notification[]

  @@map("users")
}

model Permission {
  id        String   @id @default(cuid())
  role      Role
  resource  String
  action    String
  createdAt DateTime @default(now())

  @@unique([role, resource, action])
  @@index([role])
  @@map("permissions")
}

model Business {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  type                   String?
  industry               String?
  location               String?
  targetAudience         Json?
  budget                 Decimal? @db.Decimal(14, 2)
  onlineOffline          String?
  productCategory        String?
  pricing                Json?
  manufacturingSourcing  String?
  launchTimeline         String?
  revenueGoal            Decimal? @db.Decimal(14, 2)
  existingAudience       Json?
  existingWebsite        String?
  existingSocial         Json?
  existingCustomers      Int?
  constraints            String?
  model                  Json?
  customerProfile        Json?
  positioning            Json?
  strategy               Json?
  roadmap                Json?
  kpis                   Json?
  risks                  Json?
  opportunities          Json?
  recommendedTools       Json?
  recommendedAutomations Json?
  onboardingCompleted    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("businesses")
}

model BusinessGoal {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  metric      String?
  target      Decimal?  @db.Decimal(14, 2)
  unit        String?
  timeframe   String?
  status      String    @default("ACTIVE")
  dueDate     DateTime?
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("business_goals")
}

model BusinessPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  type        String
  value       Json?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@map("business_policies")
}

model BusinessMemory {
  id         String                       @id @default(cuid())
  tenantId   String
  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       MemoryType
  content    String
  source     String?
  confidence Float?
  entityType String?
  entityId   String?
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("business_memories")
}

model BusinessDecision {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  rationale    String?
  options      Json?
  decidedValue Json?
  impact       String?
  confidence   Float?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@map("business_decisions")
}

model BusinessEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       String
  entityType String?
  entityId   String?
  payload    Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("business_events")
}

enum StoreStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Store {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storefrontId String
  storefront   Storefront  @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  status       StoreStatus @default(DRAFT)
  isActive     Boolean     @default(true)
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storefrontId, slug])
  @@index([tenantId])
  @@map("stores")
}

model Storefront {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  subdomain    String?       @unique
  domain       String?       @unique
  theme        Json?
  settings     Json?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  products     Product[]
  orders       Order[]
  pages        Page[]
  collections  Collection[]
  storeDomains StoreDomain[]
  carts        Cart[]
  stores       Store[]
  themes       Theme[]

  @@map("storefronts")
}

model Page {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storefrontId   String
  storefront     Storefront    @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  type           PageType      @default(CUSTOM)
  status         String        @default("DRAFT")
  schema         Json?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sections       PageSection[]

  @@unique([storefrontId, slug])
  @@index([tenantId])
  @@map("pages")
}

model Theme {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name         String
  colors       Json
  fonts        Json?
  layout       Json?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId])
  @@index([storefrontId])
  @@map("themes")
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  content   Json?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@map("page_sections")
}

model Collection {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  image        String?
  featured     Boolean    @default(false)
  sortOrder    Int        @default(0)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([storefrontId, slug])
  @@index([tenantId])
  @@map("collections")
}

model Product {
  id                 String              @id @default(cuid())
  storefrontId       String
  storefront         Storefront          @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  tenantId           String?
  name               String
  slug               String
  description        String?
  price              Decimal             @db.Decimal(10, 2)
  compareAtPrice     Decimal?            @db.Decimal(10, 2)
  cost               Decimal?            @db.Decimal(10, 2)
  images             String[]
  category           String?
  categoryId         String?
  tags               String[]
  inventory          Int                 @default(0)
  isActive           Boolean             @default(true)
  metadata           Json?
  seoTitle           String?
  seoDescription     String?
  lowStockThreshold  Int                 @default(5)
  variants           ProductVariant[]
  collections        Collection[]
  inventoryMovements InventoryMovement[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  cartItems          CartItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  inventoryItems     InventoryItem[]
  lowStockAlerts     LowStockAlert[]

  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  sku                String?             @unique
  price              Decimal?            @db.Decimal(10, 2)
  inventory          Int                 @default(0)
  attributes         Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  inventoryItems     InventoryItem[]

  @@map("product_variants")
}

model InventoryMovement {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  type          String
  quantity      Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime        @default(now())

  @@index([tenantId])
  @@index([productId])
  @@map("inventory_movements")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storefrontId    String
  storefront      Storefront  @relation(fields: [storefrontId], references: [id])
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  tax             Decimal     @db.Decimal(10, 2)
  shipping        Decimal?    @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("USD")
  shippingAddress Json?
  billingAddress  Json?
  notes           String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  commission      Commission?
  payments        Payment[]
  refunds         Refund[]
  shipments       Shipment[]
  invoices        Invoice[]

  @@map("orders")
}

model Cart {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId    String?    @unique
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  price     Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Customer {
  id               String            @id @default(cuid())
  tenantId         String
  email            String
  phone            String?
  firstName        String?
  lastName         String?
  tags             String[]          @default([])
  segment          String?
  source           String?
  notes            String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  conversations    Conversation[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  emailMessages    EmailMessage[]
  smsMessages      SMSMessage[]
  whatsappMessages WhatsAppMessage[]
  carts            Cart[]
  Activity         Activity[]
  Deal             Deal[]

  @@map("customers")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)
  price     Decimal         @db.Decimal(10, 2)
  total     Decimal         @db.Decimal(10, 2)
  name      String?

  @@map("order_items")
}

model Commission {
  id            String           @id @default(cuid())
  tenantId      String
  orderId       String?          @unique
  order         Order?           @relation(fields: [orderId], references: [id])
  headUserId    String
  headUser      User             @relation("HeadCommissions", fields: [headUserId], references: [id])
  partnerUserId String
  partnerUser   User             @relation("PartnerCommissions", fields: [partnerUserId], references: [id])
  amount        Decimal          @db.Decimal(10, 2)
  partnerRate   Decimal          @default(0) @db.Decimal(5, 2)
  headRate      Decimal          @default(0) @db.Decimal(5, 2)
  headShare     Decimal          @db.Decimal(10, 2)
  partnerShare  Decimal          @db.Decimal(10, 2)
  partnerId     String?
  headId        String?
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  approvedAt    DateTime?
  approvedBy    String?
  notes         String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("commissions")
}

model PartnerAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  headUserId    String
  headUser      User     @relation("HeadRelation", fields: [headUserId], references: [id], onDelete: Cascade)
  partnerUserId String
  partnerUser   User     @relation("PartnerRelation", fields: [partnerUserId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([headUserId, partnerUserId])
  @@map("partner_assignments")
}

model HeadAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("head_assignments")
}

model Lead {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id])
  status       LeadStatus @default(NEW)
  source       String?
  score        Int        @default(0)
  pipeline     String?
  stage        String?
  assignedTo   String?
  assignedUser User?      @relation(fields: [assignedTo], references: [id])
  notes        String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Activity     Activity[]
  Deal         Deal[]

  @@index([tenantId])
  @@index([status])
  @@map("leads")
}

model Company {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  domain    String?
  industry  String?
  size      String?
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
  Deal      Deal[]

  @@index([tenantId])
  @@map("companies")
}

model Segment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rules       Json?
  customerIds String[]
  isDynamic   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("segments")
}

model Conversation {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
