# ZYRA — Environment Configuration
# Copy this file to .env and fill in real values before deploying.
# Run `bash scripts/generate-secrets.sh` to generate JWT and DB passwords.

# ─── DATABASE ───────────────────────────────────────────────
# PostgreSQL connection string (use DATABASE_URL_PROD in production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://zyra:zyra_secure_pass@localhost:5432/zyra_development?schema=public"
DATABASE_URL_QA="postgresql://zyra:zyra_secure_pass@localhost:5432/zyra_qa?schema=public"
DATABASE_URL_PROD="postgresql://zyra:zyra_secure_pass@localhost:5432/zyra_production?schema=public"
DATABASE_SSL="false"  # Set "true" in production for SSL connections

# ─── REDIS ──────────────────────────────────────────────────
# Redis connection string. Use redis://:PASSWORD@HOST:PORT for auth.
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""  # Set a strong password in production

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Must be at least 32 characters; 64+ recommended for production.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_RANDOM_SECRET"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── WEB APP ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"

# ─── AI SERVICE (Ollama) ────────────────────────────────────
# Phase 0.14 — Local LLM Inference
# Point to your Ollama server (leave empty if not using AI features)
AI_SERVICE_URL="http://localhost:8020"
AI_API_KEY=""  # Not needed for local Ollama; set if using cloud provider

# Ollama self-hosted LLM configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=100
AI_PROVIDER=ollama

# ─── STORAGE (S3-compatible) ────────────────────────────────
# Configure for MinIO, AWS S3, or any S3-compatible provider
S3_ENDPOINT=""          # e.g. https://s3.amazonaws.com or http://localhost:9000
S3_BUCKET="zyra-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# ─── EMAIL (SMTP) ──────────────────────────────────────────
# Phase 0.13 — Email Infrastructure
# Supported providers: Gmail, SendGrid, Resend, AWS SES, custom SMTP
# Gmail example: host=smtp.gmail.com, port=587 (STARTTLS)
# SendGrid example: host=smtp.sendgrid.net, port=587
# Resend example: host=smtp.resend.com, port=465 (SSL)
SMTP_HOST=""            # e.g. smtp.gmail.com
SMTP_PORT=""            # e.g. 587 (TLS) or 465 (SSL)
SMTP_USER=""            # SMTP username / API key
SMTP_PASS=""            # SMTP password / API secret
SMTP_SECURE="false"     # true for port 465 SSL, false for STARTTLS ports
EMAIL_FROM="noreply@ceozyra.com"  # Sender address shown in recipients' inbox

# ─── WHATSAPP (Meta Cloud API) ──────────────────────────────
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_API_TOKEN=""   # Permanent access token from Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=""  # Phone number ID from Meta App Dashboard

# ─── SMS ────────────────────────────────────────────────────
# Supported providers: twilio, msg91, firebase (via Twilio)
SMS_PROVIDER=""         # "twilio" | "msg91" | ""
SMS_API_KEY=""
SMS_SENDER_ID=""        # e.g. "ZYRA" (6 chars max for most providers)

# ─── PAYMENTS ──────────────────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Stripe (International)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── OAUTH ──────────────────────────────────────────────────
# Google OAuth 2.0 (for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── META (Facebook / Instagram) ─────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""

# ─── OBSERVABILITY ──────────────────────────────────────────
# Sentry error tracking — get your DSN from sentry.io
SENTRY_DSN=""
# OpenTelemetry collector endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ─── ENVIRONMENT ────────────────────────────────────────────
NODE_ENV="development"  # development | production
APP_ENV="development"   # development | qa | production
APP_NAME="ZYRA"
APP_URL="https://ceozyra.com"
